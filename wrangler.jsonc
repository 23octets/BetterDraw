// Site statique servi par Cloudflare Workers (Workers Builds lance `npm run build` puis `npx wrangler deploy`).
// L'app navigue par hash (#/…), donc aucune réécriture SPA n'est nécessaire.
{
  "name": "betterdraw",
  "compatibility_date": "2026-11-10",
  "assets": { "directory": "./dist" },
  "routes": [{ "pattern": "betterdraw.yohan.one", "custom_domain": true }],
  // URL workers.dev et previews par branche gardées, comme lors du premier déploiement
  "workers_dev": true,
  "preview_urls": true,
  // Requis par `wrangler preview` pour les builds de branches et de PR.
  "previews": {},
  "observability": { "enabled": true }
}
