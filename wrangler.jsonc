// Assets statiques et API de comptes servis par Cloudflare Workers.
// L'app navigue par hash (#/…), donc aucune réécriture SPA n'est nécessaire.
{
  "name": "betterdraw",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-10",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "routes": [{ "pattern": "betterdraw.yohan.one", "custom_domain": true, "previews_enabled": true }],
  // URL workers.dev et previews par branche gardées, comme lors du premier déploiement
  // Domaine ajouté dans Cloudflare pour les previews ; garder la configuration versionnée.
  "workers_dev": true,
  "preview_urls": true,
  // Requis par `npx wrangler preview`, lancé par Workers Builds sur les branches hors production
  "previews": {
    "d1_databases": [{
      "binding": "ACCOUNTS",
      "database_name": "betterdraw-accounts-dev",
      "database_id": "b7724059-6aea-4605-9b2f-f7b54dd7ac14",
      "migrations_dir": "migrations"
    }]
  },
  "observability": { "enabled": true }
}
